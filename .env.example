# Админка Keitaro. Ключ: Профиль → API ключи на https://tdgk.host/admin/
KEITARO_BASE_URL=https://tdgk.host
KEITARO_API_KEY=

# sqlite по умолчанию создаётся в ./data/app.db
# DATABASE_URL=sqlite:////absolute/path/app.db

# Что подставлять в новую кампанию. Имена ищутся в API.
DOMAIN_NAME=kylovoa.com
GROUP_NAME=FORTESTS
SOURCE_NAME=FORTESTS
TIMEZONE=Europe/Moscow

# 1 — не ходить в Keitaro, даже если ключ задан
KEITARO_MOCK=0
